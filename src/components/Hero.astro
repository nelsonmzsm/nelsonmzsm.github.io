---
import { Image } from 'astro:assets';
import { getDict, localePath, type Locale } from '../i18n';
import heroPhoto from '../assets/hero-photo.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const prefix = localePath(locale);
---

<!--
  白背景＋本人写真のヒーロー。
  PC：テキストを左、写真を右の余白に「収める」（object-contain）。
       余った余白は塗り足さず、紙色の背景のまま白く抜ける。
  スマホ：写真を上、テキストを下に積む。写真は上下端をフェザー（マスク）でぼかし、
          背景の紙色に溶け込むようにして、四角い切り抜き感を出さない。
  写真の差し替えは src/assets/hero-photo.png。
-->
<section class="relative overflow-hidden bg-paper">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:py-24">
    <div
      class="flex flex-col items-center gap-8 sm:flex-row sm:items-end sm:justify-between sm:gap-10"
    >
      <div class="max-w-xl sm:order-1">
        <!-- 幅が足りない画面では自然に2行へ折り返す（JSは2行を超えたときだけ縮小） -->
        <h1
          id="hero-title"
          class="fade-in font-serif text-3xl leading-normal font-semibold text-ink sm:text-4xl sm:leading-normal sm:whitespace-nowrap lg:text-5xl lg:leading-normal"
          set:html={dict.hero.titleHtml}
        />
        <p
          id="hero-lead"
          class="fade-in mt-6 text-[0.9375rem] leading-loose text-ink-soft sm:text-base sm:leading-relaxed"
          style="transition-delay: 120ms"
          set:html={dict.hero.lead}
        />
        <!-- 資格・肩書きはヒーローには置かず、「できること」の各カード（quals）に移した -->
        <div class="fade-in mt-8" style="transition-delay: 240ms">
          <a
            href={`${prefix}#about`}
            class="hover-lift inline-block rounded-full bg-akatsuchi px-7 py-3 text-sm text-paper shadow-sm hover:bg-umi-deep hover:shadow-md"
          >
            {dict.hero.cta} ↓
          </a>
        </div>
      </div>

      <!-- 写真：PCは右の余白に収める（伸ばさない・切り抜かない）。
           スマホは上下端をフェザーして背景になじませる（hero-photo-fadeはsm未満のみ有効） -->
      <div class="hero-photo-fade w-48 shrink-0 sm:order-2 sm:w-auto sm:self-end">
        <Image
          src={heroPhoto}
          alt={dict.hero.photoAlt ?? 'ネルソン水嶋'}
          widths={[320, 480, 640]}
          sizes="(min-width: 640px) 320px, 192px"
          class="h-auto w-full object-contain sm:h-80 sm:w-auto md:h-96"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* スマホのみ：写真の四辺を紙色へ楕円形にフェザーし、四角い切り抜き感をなくす
     （上下だけだと左右に硬い輪郭が残るため、全周をぼかす） */
  .hero-photo-fade {
    -webkit-mask-image: radial-gradient(
      ellipse 68% 62% at 50% 42%,
      black 45%,
      transparent 92%
    );
    mask-image: radial-gradient(
      ellipse 68% 62% at 50% 42%,
      black 45%,
      transparent 92%
    );
  }
  @media (min-width: 640px) {
    .hero-photo-fade {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>

<script>
  // 見出しのフィット：コピーが<br>区切りの行数（2行）から増えないよう、
  // はみ出す場合だけ文字サイズを1pxずつ縮める。
  // 画面幅・文字サイズ設定（あボタン）・言語の全組み合わせで「ちょうど2行」を保証する。
  const title = document.getElementById('hero-title');
  if (title) {
    const fit = () => {
      // inline-block（均等割り付け）でも動くよう、親要素の幅を上限にする
      const limit = () => title.parentElement?.clientWidth ?? title.clientWidth;
      // モバイルは自然折り返し（nowrapなし）のため、幅は常にコンテナ内に収まってしまい
      // scrollWidthでは「3行目にあふれた」ことを検知できない。行の高さで行数を判定する
      const maxHeight = () => parseFloat(getComputedStyle(title).lineHeight) * 2;
      title.style.fontSize = '';
      let fs = parseFloat(getComputedStyle(title).fontSize);
      let guard = 60;
      while (
        (title.scrollWidth > limit() + 1 || title.scrollHeight > maxHeight() + 1) &&
        fs > 16 &&
        guard-- > 0
      ) {
        fs -= 1;
        title.style.fontSize = `${fs}px`;
      }
    };
    fit();
    // Webフォント読み込みで幅が変わるので、読み込み完了後にもう一度
    document.fonts?.ready.then(fit);
    window.addEventListener('resize', fit);
    // 文字サイズボタンで html[data-fontsize] が変わったときも再計算
    new MutationObserver(fit).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-fontsize'],
    });
  }
</script>
