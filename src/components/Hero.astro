---
import { Image } from 'astro:assets';
import { getDict, localePath, type Locale } from '../i18n';
import heroCover from '../assets/hero-cover.png';
import heroCoverSp from '../assets/hero-cover-sp.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const prefix = localePath(locale);
---

<!--
  雑誌の扉ページ風ヒーロー：
  写真1枚をセクション全体の背景として敷き、写真全体に均一な暗いオーバーレイをかける。
  さらに文字が乗る左側だけ暗さを一段追加し（右へフェードアウト）、
  写真の明るい部分と文字が重なってもコントラストが落ちないようにする。
  文字（白＋強めのtext-shadow）は常にオーバーレイの上に乗るので、
  「文字と写真の境界がはっきりしている」状態を保てる（スマホ／PC共通の構成）。
  写真はPC/スマホで別カット（PCは人物右寄りの横長カット、スマホは人物中央の縦長カット）。
  差し替えは src/assets/hero-cover.png（PC）／hero-cover-sp.jpg（スマホ）。
-->
<section class="relative overflow-hidden">
  <div aria-hidden="true" class="absolute inset-0 overflow-hidden">
    <!-- 背景写真：じわーっとズーム（kenburns）＋スクロールに遅れてついてくるパララックス。
         上下対称に延ばすことで、写真の中央がヒーローの中央に来る
         （上だけ延ばすと写真の上部が見切れる）。延長ぶんはパララックス移動時の見切れ防止も兼ねる。
         延ばし幅は-40だと今回の人物カット（顔が上端寄り）で頭が切れてしまうため、-4まで縮小 -->
    <div class="hero-parallax absolute inset-x-0 -top-4 -bottom-4 will-change-transform">
      <!-- PC：横長カット。人物が右寄りなので、クロップ時も右側（人物）を優先して残す -->
      <Image
        src={heroCover}
        alt=""
        widths={[960, 1440, 1920]}
        sizes="100vw"
        class="kenburns hidden h-full w-full object-cover object-right sm:block"
        loading="eager"
        fetchpriority="high"
      />
      <!-- スマホ：縦長カット。右上のスペースに顔が来るよう、右寄り・上寄りでcover -->
      <Image
        src={heroCoverSp}
        alt=""
        widths={[480, 768, 960]}
        sizes="100vw"
        class="kenburns h-full w-full object-cover object-[78%_18%] sm:hidden"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <!-- 写真全体を暗くするのはやめ、写真本来の明るさ・色味を右側は活かす。
         暗さはテキスト列（max-w-3xl）の幅にだけ集中させ、右へ向けてフェザーで抜く
         （参考：人物写真の左側だけにテキスト用の暗いパネルを敷き、右は写真そのままという構図） -->
    <div class="absolute inset-0 bg-ink/12"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/88 via-ink/80 via-45% to-transparent to-75%"></div>
    <!-- 下端だけ、次のセクション（紙色の背景）へなじませる -->
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-paper to-transparent"></div>
  </div>

  <!-- 写真を主役として見せつつ、文字サイズ「大」でも収まる高さを確保する。
       flexでの中央揃えはタイトルの幅測定（フィットスクリプト）を狂わせるため使わず、
       上下の余白だけで縦位置を調整する（これまでも実績のある組み方） -->
  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:py-32">
    <div class="max-w-3xl">
      <!-- 幅が足りない画面では自然に2行へ折り返す（JSでの強制1行化はやめ、CSSの折り返しに任せる） -->
      <h1
        id="hero-title"
        class="fade-in font-serif text-3xl leading-normal font-semibold text-paper [text-shadow:0_1px_3px_rgba(0,0,0,0.8),0_4px_16px_rgba(0,0,0,0.5)] sm:text-4xl sm:leading-normal sm:whitespace-nowrap lg:text-5xl lg:leading-normal"
        set:html={dict.hero.titleHtml}
      />
      <p
        id="hero-lead"
        class="fade-in mt-6 text-[0.9375rem] leading-loose text-paper [text-shadow:0_1px_2px_rgba(0,0,0,0.75),0_3px_12px_rgba(0,0,0,0.45)] sm:text-base sm:leading-relaxed"
        style="transition-delay: 120ms"
        set:html={dict.hero.lead}
      />
      <!-- 資格・肩書きはヒーローには置かず、「できること」の各カード（quals）に移した -->
      <div class="fade-in mt-8" style="transition-delay: 240ms">
        <a
          href={`${prefix}#about`}
          class="hover-lift inline-block rounded-full bg-paper px-7 py-3 text-sm text-umi-deep shadow-sm hover:bg-white hover:shadow-md"
        >
          {dict.hero.cta} ↓
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // 見出しのフィット：コピーが<br>区切りの行数（2行）から増えないよう、
  // はみ出す場合だけ文字サイズを1pxずつ縮める。
  // 画面幅・文字サイズ設定（あボタン）・言語の全組み合わせで「ちょうど2行」を保証する。
  const title = document.getElementById('hero-title');
  if (title) {
    const fit = () => {
      // inline-block（均等割り付け）でも動くよう、親要素の幅を上限にする
      const limit = () => title.parentElement?.clientWidth ?? title.clientWidth;
      // モバイルは自然折り返し（nowrapなし）のため、幅は常にコンテナ内に収まってしまい
      // scrollWidthでは「3行目にあふれた」ことを検知できない。行の高さで行数を判定する
      const maxHeight = () => parseFloat(getComputedStyle(title).lineHeight) * 2;
      title.style.fontSize = '';
      let fs = parseFloat(getComputedStyle(title).fontSize);
      let guard = 60;
      while (
        (title.scrollWidth > limit() + 1 || title.scrollHeight > maxHeight() + 1) &&
        fs > 16 &&
        guard-- > 0
      ) {
        fs -= 1;
        title.style.fontSize = `${fs}px`;
      }
    };
    fit();
    // Webフォント読み込みで幅が変わるので、読み込み完了後にもう一度
    document.fonts?.ready.then(fit);
    window.addEventListener('resize', fit);
    // 文字サイズボタンで html[data-fontsize] が変わったときも再計算
    new MutationObserver(fit).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-fontsize'],
    });
  }

  // パララックス：スクロール量の2割ほど背景写真が遅れて追いかけてくる（奥行き感）
  const bg = document.querySelector<HTMLElement>('.hero-parallax');
  if (bg) {
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      if (y < window.innerHeight * 1.5) {
        bg.style.transform = `translateY(${y * 0.22}px)`;
      }
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
  }
</script>
