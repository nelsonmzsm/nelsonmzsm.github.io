---
import { getImage } from 'astro:assets';
import { getDict, localePath, type Locale } from '../i18n';
import hero1 from '../assets/hero-1.jpg';
import hero2 from '../assets/hero-2.jpg';
import hero3 from '../assets/hero-3.jpg';
import hero4 from '../assets/hero-4.jpg';
import hero5 from '../assets/hero-5.jpg';
import hero6 from '../assets/hero-6.jpg';
import hero7 from '../assets/hero-7.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const prefix = localePath(locale);

// 背景写真は読み込みのたびにランダムで1枚選ぶ（クライアントJSで切り替え）。
// 候補の追加・差し替えは src/assets/hero-1〜6.jpg。
// position: object-cover時にどこを基準に切り抜くか（人物が中央から外れている写真向け）
const heroCandidates = [
  { src: hero1 },
  { src: hero2 },
  { src: hero3 },
  { src: hero4, position: 'left 15%' }, // 本人の頭が見切れないよう、上寄りだが少し余裕を持たせる
  { src: hero5 },
  { src: hero6 },
  { src: hero7 },
];
const heroSources = await Promise.all(
  heroCandidates.map(async ({ src, position }) => {
    const [w960, w1920] = await Promise.all([
      getImage({ src, width: 960, format: 'webp' }),
      getImage({ src, width: 1920, format: 'webp' }),
    ]);
    return {
      src: w1920.src,
      srcset: `${w960.src} 960w, ${w1920.src} 1920w`,
      position: position ?? 'center',
    };
  })
);
---

<!--
  雑誌の扉ページ風ヒーロー：
  スマホ／PCとも、写真は加工なしでそのまま見せる（カード・すりガラスパネルは使わない）。
  文字は写真に直接重ね、白文字＋ドロップシャドウで、どんな写真の上でも読めるようにする。
  ・スマホ：写真とコピーが重ならないよう、上下に分けて両方ちゃんと見せる（写真側は白文字不要）
  ・PC（sm以上）：写真を画面いっぱいに背景として敷き、コピーを白文字＋影で直接重ねる
  背景写真は複数候補からランダム表示（候補は src/assets/hero-1〜7.jpg）。
-->
<section class="relative overflow-hidden">
  <!-- 写真：スマホは通常フローの横長ブロック、PCはセクション全体を覆う背景 -->
  <div aria-hidden="true" class="relative w-full overflow-hidden sm:absolute sm:inset-0">
    <!-- 背景写真：じわーっとズーム（kenburns）。PCのみスクロールに遅れてついてくるパララックスも付く。
         PCでは上下対称に-40ずつ延ばすことで、写真の中央がヒーローの中央に来る
         （上だけ延ばすと写真の上部が見切れる）。延長ぶんはパララックス移動時の見切れ防止も兼ねる -->
    <div class="hero-parallax relative sm:absolute sm:inset-x-0 sm:-top-40 sm:-bottom-40 sm:will-change-transform">
      <img
        id="hero-bg-img"
        data-candidates={JSON.stringify(heroSources)}
        src={heroSources[0].src}
        srcset={heroSources[0].srcset}
        sizes="100vw"
        style={`object-position: ${heroSources[0].position}`}
        alt=""
        class="kenburns aspect-[4/3] w-full object-cover sm:aspect-auto sm:h-full"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <!-- PCは写真を画面いっぱいに見せるが、下端だけページ背景へなじませるフェードを残す -->
    <div class="hidden sm:block sm:absolute sm:inset-x-0 sm:bottom-0 sm:h-24 sm:bg-gradient-to-t sm:from-paper sm:to-transparent"></div>
  </div>

  <!-- 余白はほどほどに：文字サイズ「大」(145%)でもファーストビューにCTAボタンが収まる範囲で、ゆとりを持たせる -->
  <!-- スマホは写真の下に続く通常セクションなので上の余白は控えめ、PCは写真に重ねるのでゆったり -->
  <div class="relative mx-auto max-w-6xl px-4 pt-6 pb-10 sm:px-6 sm:pt-20 sm:pb-12 lg:pt-24 lg:pb-14">
    <!-- PCは写真に文字を直接重ねるので白文字＋ドロップシャドウで読みやすさを確保。
         スマホは写真と重ならない（下の通常フロー）ので、これまで通りの色のまま -->
    <div class="max-w-3xl">
      <!-- whitespace-nowrap＋下のフィットスクリプトで、<br>区切りの2行から増えないようにする -->
      <h1
        id="hero-title"
        class="fade-in font-serif text-3xl leading-normal font-semibold whitespace-nowrap text-umi-deep sm:text-4xl sm:leading-normal sm:text-paper sm:[text-shadow:0_2px_16px_rgba(0,0,0,0.55),0_1px_4px_rgba(0,0,0,0.5)] lg:text-5xl lg:leading-normal"
        set:html={dict.hero.titleHtml}
      />
      <p
        id="hero-lead"
        class="fade-in mt-6 text-[0.9375rem] leading-relaxed text-ink sm:text-base sm:text-paper sm:[text-shadow:0_1px_10px_rgba(0,0,0,0.6),0_1px_3px_rgba(0,0,0,0.55)]"
        style="transition-delay: 120ms"
        set:html={dict.hero.lead}
      />
      <!-- 資格・肩書きはヒーローには置かず、「できること」の各カード（quals）に移した -->
      <div class="fade-in mt-8" style="transition-delay: 240ms">
        <a
          href={`${prefix}#about`}
          class="hover-lift inline-block rounded-full bg-umi px-7 py-3 text-sm text-paper shadow-sm hover:bg-umi-deep hover:shadow-md sm:bg-paper sm:text-umi-deep sm:shadow-md sm:hover:bg-white"
        >
          {dict.hero.cta} ↓
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // 背景写真をランダムに1枚選んで差し込む（読み込みのたびに変わる）。
  // 初期HTMLには1枚目の写真を仮のsrcとして焼き込んであるので、
  // このスクリプトが万一失敗・後回しにされても背景が消えることはない。
  // ※他の処理より先に実行し、後続の処理でエラーが起きても影響を受けないようにする。
  try {
    const heroImg = document.getElementById('hero-bg-img') as HTMLImageElement | null;
    if (heroImg) {
      const candidates = JSON.parse(heroImg.dataset.candidates || '[]') as {
        src: string;
        srcset: string;
        position: string;
      }[];
      if (candidates.length > 0) {
        const pick = candidates[Math.floor(Math.random() * candidates.length)];
        heroImg.src = pick.src;
        heroImg.srcset = pick.srcset;
        heroImg.sizes = '100vw';
        heroImg.style.objectPosition = pick.position;
      }
      delete heroImg.dataset.candidates;
    }
  } catch {
    // 失敗しても、焼き込み済みの1枚目の写真がそのまま表示され続ける
  }

  // 見出しのフィット：コピーが<br>区切りの行数（2行）から増えないよう、
  // はみ出す場合だけ文字サイズを1pxずつ縮める。
  // 画面幅・文字サイズ設定（あボタン）・言語の全組み合わせで「ちょうど2行」を保証する。
  const title = document.getElementById('hero-title');
  if (title) {
    const fit = () => {
      // inline-block（均等割り付け）でも動くよう、親要素の幅を上限にする
      const limit = () => title.parentElement?.clientWidth ?? title.clientWidth;
      title.style.fontSize = '';
      let fs = parseFloat(getComputedStyle(title).fontSize);
      let guard = 60;
      while (title.scrollWidth > limit() + 1 && fs > 16 && guard-- > 0) {
        fs -= 1;
        title.style.fontSize = `${fs}px`;
      }
    };
    fit();
    // Webフォント読み込みで幅が変わるので、読み込み完了後にもう一度
    document.fonts?.ready.then(fit);
    window.addEventListener('resize', fit);
    // 文字サイズボタンで html[data-fontsize] が変わったときも再計算
    new MutationObserver(fit).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-fontsize'],
    });
  }

  // パララックス：スクロール量の2割ほど背景写真が遅れて追いかけてくる（奥行き感）。
  // スマホは写真が通常フローの一部（背景ではない）なので、PC幅のときだけ動かす。
  const bg = document.querySelector<HTMLElement>('.hero-parallax');
  const isDesktop = window.matchMedia('(min-width: 640px)');
  if (bg) {
    let ticking = false;
    const update = () => {
      if (!isDesktop.matches) {
        bg.style.transform = '';
        ticking = false;
        return;
      }
      const y = window.scrollY;
      if (y < window.innerHeight * 1.5) {
        bg.style.transform = `translateY(${y * 0.22}px)`;
      }
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
  }
</script>
