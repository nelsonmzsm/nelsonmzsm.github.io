---
import { Image } from 'astro:assets';
import { getDict, localePath, type Locale } from '../i18n';
import heroPhoto from '../assets/hero-photo.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const prefix = localePath(locale);
const photoAlt = dict.hero.photoAlt ?? 'ネルソン水嶋';
---

<!--
  白背景＋本人写真のヒーロー。写真は頭から腰あたりまでをobject-cover+object-topで
  切り出して使う（元画像は膝下まで写っているが、脚は見せない）。
  PC：テキストを左、写真を右に大きく配置。
  スマホ：写真をテキストの背景として上部に大きく敷き、四辺を楕円マスクで
          紙色にフェザーしてなじませる。文字の後ろが濃い部分（服など）に
          かかっても読めるよう、上から紙色のグラデーションを薄く重ねる。
  写真の差し替えは src/assets/hero-photo.png。
-->
<section class="relative isolate overflow-hidden bg-paper">
  <!-- モバイル用：テキストの背景として敷く写真（sm以上では非表示） -->
  <div
    class="hero-photo-fade absolute inset-x-0 top-0 -z-10 h-[26rem] w-full sm:hidden"
    aria-hidden="true"
  >
    <Image
      src={heroPhoto}
      alt=""
      widths={[480, 640, 768]}
      sizes="100vw"
      class="h-full w-full object-cover object-top"
      loading="eager"
      fetchpriority="high"
    />
    <!-- 見出し～本文が乗る範囲（上から約65%）はしっかり紙色で保護し、
         濃紺のシャツと重なって読めなくなるのを防ぐ。残りの下側だけ写真を素で見せる -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-paper/95 from-0% via-paper/92 via-65% to-transparent to-100%"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:py-24">
    <div
      class="flex flex-col items-center gap-8 sm:flex-row sm:items-center sm:justify-between sm:gap-10"
    >
      <div class="max-w-xl sm:order-1">
        <!-- 幅が足りない画面では自然に2行へ折り返す（JSは2行を超えたときだけ縮小） -->
        <h1
          id="hero-title"
          class="fade-in font-serif text-3xl leading-normal font-semibold text-ink sm:text-4xl sm:leading-normal sm:whitespace-nowrap lg:text-5xl lg:leading-normal"
          set:html={dict.hero.titleHtml}
        />
        <p
          id="hero-lead"
          class="fade-in mt-6 text-[0.9375rem] leading-loose text-ink-soft sm:text-base sm:leading-relaxed"
          style="transition-delay: 120ms"
          set:html={dict.hero.lead}
        />
        <!-- 資格・肩書きはヒーローには置かず、「できること」の各カード（quals）に移した -->
        <div class="fade-in mt-8" style="transition-delay: 240ms">
          <a
            href={`${prefix}#about`}
            class="hover-lift inline-block rounded-full bg-akatsuchi px-7 py-3 text-sm text-paper shadow-sm hover:bg-umi-deep hover:shadow-md"
          >
            {dict.hero.cta} ↓
          </a>
        </div>
      </div>

      <!-- PC用：右側に大きく、頭から腰あたりまでのクロップ（sm未満では非表示） -->
      <div class="hidden shrink-0 sm:order-2 sm:block sm:w-72 md:w-96 lg:w-[28rem]">
        <Image
          src={heroPhoto}
          alt={photoAlt}
          widths={[480, 640, 896]}
          sizes="(min-width: 1024px) 28rem, (min-width: 640px) 24rem, 0px"
          class="aspect-[4/5] w-full rounded-2xl object-cover object-top"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* スマホのみ：写真の四辺を紙色へ楕円形にフェザーし、四角い切り抜き感をなくす */
  .hero-photo-fade {
    -webkit-mask-image: radial-gradient(ellipse 75% 70% at 50% 30%, black 50%, transparent 95%);
    mask-image: radial-gradient(ellipse 75% 70% at 50% 30%, black 50%, transparent 95%);
  }
</style>

<script>
  // 見出しのフィット：コピーが<br>区切りの行数（2行）から増えないよう、
  // はみ出す場合だけ文字サイズを1pxずつ縮める。
  // 画面幅・文字サイズ設定（あボタン）・言語の全組み合わせで「ちょうど2行」を保証する。
  const title = document.getElementById('hero-title');
  if (title) {
    const fit = () => {
      // inline-block（均等割り付け）でも動くよう、親要素の幅を上限にする
      const limit = () => title.parentElement?.clientWidth ?? title.clientWidth;
      // モバイルは自然折り返し（nowrapなし）のため、幅は常にコンテナ内に収まってしまい
      // scrollWidthでは「3行目にあふれた」ことを検知できない。行の高さで行数を判定する
      const maxHeight = () => parseFloat(getComputedStyle(title).lineHeight) * 2;
      title.style.fontSize = '';
      let fs = parseFloat(getComputedStyle(title).fontSize);
      let guard = 60;
      while (
        (title.scrollWidth > limit() + 1 || title.scrollHeight > maxHeight() + 1) &&
        fs > 16 &&
        guard-- > 0
      ) {
        fs -= 1;
        title.style.fontSize = `${fs}px`;
      }
    };
    fit();
    // Webフォント読み込みで幅が変わるので、読み込み完了後にもう一度
    document.fonts?.ready.then(fit);
    window.addEventListener('resize', fit);
    // 文字サイズボタンで html[data-fontsize] が変わったときも再計算
    new MutationObserver(fit).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-fontsize'],
    });
  }
</script>
