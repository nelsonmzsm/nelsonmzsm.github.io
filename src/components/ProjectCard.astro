---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  accent: string;
}

const { project, accent } = Astro.props;
const { title, period, summary, thumbnail, format, cardLabel, cardColor } = project.data;

// tabunkaカテゴリなどで「冊子」「ツール」をひと目で区別できるようにするバッジ
const FORMAT_LABELS: Record<string, string> = { booklet: '冊子', tool: 'ツール' };
---

<!-- h-full + flex で縦幅を揃え、あふれた文は line-clamp で「…」省略する。
     スマホでは常に2カラムで並ぶため、余白・文字サイズを控えめにしておく -->
<a
  href={`/projects/${project.id}/`}
  class="hover-lift group flex h-full flex-col overflow-hidden rounded-xl border border-sand bg-card shadow-sm hover:shadow-md"
>
  <div class="relative">
    {
      thumbnail && thumbnail.length > 0 ? (
        // 縦長・ロゴなど16:9に合わない写真をトリミングで不格好にしないよう、
        // 同じ写真の全体を拡大＋ぼかした背景の上に、写真そのものを重ねる（よくある手法）。
        // 背景の土台は白にしておき、写真の余白部分は白に馴染むようにする。
        // 切り替えは行わず、1枚目を常に表示する
        <div class="relative aspect-video w-full shrink-0 overflow-hidden bg-paper">
          <Image
            src={thumbnail[0]}
            alt=""
            width={200}
            loading="lazy"
            aria-hidden="true"
            class="absolute inset-0 h-full w-full scale-110 object-contain blur-2xl"
          />
          <Image
            src={thumbnail[0]}
            alt=""
            widths={[400, 800]}
            sizes="(min-width: 640px) 400px, 50vw"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-contain"
          />
        </div>
      ) : (
        <div class={`aspect-video w-full shrink-0 ${cardColor ?? accent} relative`} aria-hidden="true">
          <span
            class={
              cardLabel
                ? 'absolute inset-0 flex items-center justify-center px-3 text-center font-serif text-sm font-semibold text-paper sm:text-base'
                : 'absolute inset-0 flex items-center justify-center font-serif text-2xl tracking-widest text-paper/70 sm:text-3xl'
            }
          >
            {cardLabel ?? title.slice(0, 1)}
          </span>
        </div>
      )
    }
    {
      format && (
        <span class="absolute left-1.5 top-1.5 flex items-center gap-1 rounded-full bg-paper/90 px-2 py-1 text-[0.625rem] font-medium text-ink shadow-sm backdrop-blur-sm sm:left-2 sm:top-2 sm:text-xs">
          {format === 'booklet' ? (
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            </svg>
          ) : (
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z" />
            </svg>
          )}
          {FORMAT_LABELS[format]}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-3 sm:p-5">
    <p class="text-[0.6875rem] tracking-wider text-ink-soft sm:text-xs">{period}</p>
    <h4
      class="mt-1 line-clamp-2 font-serif text-sm font-semibold text-ink transition-colors duration-500 group-hover:text-akatsuchi sm:mt-1.5 sm:text-base lg:text-lg"
    >
      {title}
    </h4>
    <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-ink-soft sm:mt-2 sm:text-sm">{summary}</p>
  </div>
</a>
