---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import { getDict } from '../../i18n';

export async function getStaticPaths() {
  const items = await getCollection('news', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

// 記事本文は日本語のみのため、詳細ページは日本語ロケール固定
const dict = getDict('ja');
const formatDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const ogImage = item.data.thumbnail?.src ?? SITE.ogImage;
---

<Base
  locale="ja"
  title={`${item.data.title}｜${SITE.name}`}
  description={item.data.summary ?? item.data.title}
  ogImage={ogImage}
  ogType="article"
>
  <main>
    <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
      <a
        href="/#news"
        class="text-sm text-ink-soft transition-colors duration-300 hover:text-akatsuchi"
      >
        ← {dict.news.heading} 一覧へ
      </a>

      <header class="mt-8">
        <time
          datetime={item.data.date.toISOString().slice(0, 10)}
          class="text-sm tracking-wider text-akatsuchi tabular-nums"
        >
          {formatDate(item.data.date)}
        </time>
        <h1
          class="mt-3 font-serif text-2xl leading-relaxed font-semibold text-umi-deep sm:text-3xl sm:leading-relaxed"
        >
          {item.data.title}
        </h1>
      </header>

      {
        item.data.thumbnail && (
          <Image
            src={item.data.thumbnail}
            alt=""
            widths={[720, 1440]}
            sizes="(min-width: 768px) 720px, 100vw"
            class="mt-10 w-full rounded-xl"
          />
        )
      }

      <div
        class="prose prose-neutral mt-10 max-w-none text-ink prose-headings:font-serif prose-headings:text-umi-deep prose-a:text-akatsuchi prose-strong:text-ink"
      >
        <Content />
      </div>

      <footer class="mt-14 border-t border-sand pt-8">
        <p class="text-sm leading-loose text-ink-soft">
          気になることがあれば、
          <a href="/#contact" class="text-akatsuchi underline underline-offset-4">お気軽にどうぞ</a>。
        </p>
      </footer>
    </article>
  </main>
</Base>
